{"nodes": [{"id": "claude_atlasjs", "label": "AtlasJS Engine", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modern 2D-first TypeScript game engine designed as a plugin ecosystem so every major system can evolve independently while staying cohesive."}, {"id": "claude_performance", "label": "Performance Principle", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Performance is considered from the start: abstractions must improve architecture without hiding runtime costs; avoid unnecessary allocations and abstraction overhead."}, {"id": "claude_modularity", "label": "Modularity Principle", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each major system has one focused responsibility isolated in an independent package, so AtlasJS behaves as an ecosystem of composable modules rather than a monolith."}, {"id": "claude_plugin_architecture", "label": "Plugin-based Architecture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The core stays lightweight and independent from optional systems; rendering, physics, ECS and tooling integrate through well-defined extension points so new capabilities never require core edits."}, {"id": "claude_extensibility", "label": "Extensibility Principle", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decisions favor long-term flexibility and clear extension points over short-term convenience, so implementations can be replaced or experimented with."}, {"id": "claude_packages_directory", "label": "packages/ \u2014 Reusable Engine Modules", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packages must stay focused and independent and may never depend on an application in apps/, keeping the dependency direction one-way."}, {"id": "claude_apps_directory", "label": "apps/ \u2014 Executable Applications", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applications compose packages, but application-specific logic must not leak back into reusable engine packages."}, {"id": "claude_turborepo_monorepo", "label": "Turborepo + pnpm Monorepo", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_ai_agent_guidelines", "label": "AI Agent Guidelines", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architecture consistency is explicitly ranked above the quickest possible solution; always type code, avoid comments, avoid circular dependencies, prefer extending existing systems."}, {"id": "claude_graphify_integration", "label": "Graphify Knowledge Graph Workflow", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Codebase questions go through `graphify query` first because a scoped subgraph is much smaller than GRAPH_REPORT.md or raw grep output."}, {"id": "claude_2d_first_direction", "label": "2D-first, 3D-ready Architectural Direction", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Focus is 2D today, but no decision may make future 3D evolution impossible without a strong reason; foundational APIs avoid 2D-only assumptions."}], "edges": [{"source": "claude_atlasjs", "target": "claude_performance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_atlasjs", "target": "claude_modularity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_atlasjs", "target": "claude_plugin_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_atlasjs", "target": "claude_extensibility", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_atlasjs", "target": "claude_2d_first_direction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_atlasjs", "target": "claude_packages_directory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_atlasjs", "target": "claude_apps_directory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_turborepo_monorepo", "target": "claude_packages_directory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_modularity", "target": "clau