{"nodes": [{"id": "docs_gameplay_camera_camera_component", "label": "Camera component (LEVEL 1)", "file_type": "concept", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure data (just zoom) with no LEVEL 2 fa\u00e7ade, because there is nothing to route \u2014 activation goes through the service, not the component (the 'no fa\u00e7ade by symmetry' invariant, precedent PlayerInput)."}, {"id": "docs_gameplay_camera_cameramanager", "label": "CameraManager (CAMERA_MANAGER)", "file_type": "concept", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single authority over the active camera and screen\u2194world; deliberately the seam where multi-camera would later grow (setActive \u2192 add/setLayer, screenToWorld(entity?))."}, {"id": "docs_gameplay_camera_camerasyncsystem", "label": "CameraSyncSystem", "file_type": "concept", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in render/PreRender before sprite-render (whose culling reads getCameraViewport) and in strict order zoom \u2192 read viewport \u2192 position, since the viewport extent depends on the current zoom. It resolves the single active entity rather than iterating a query."}, {"id": "docs_gameplay_camera_cameraapi", "label": "CameraApi script service fa\u00e7ade", "file_type": "concept", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact mirror of InputApi (ScriptService<CameraManager>, static token) so scripts get screenToWorld/worldToScreen/setMain without nebula ever leaking."}, {"id": "docs_gameplay_camera_screentoworld", "label": "Camera2D.screenToWorld / worldToScreen", "file_type": "concept", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed on Camera2D because it owns the matrix and the editor can reuse it; analytic (no Mat4.invert) because without camera rotation the ortho (0,w,h,0) and the mouse space cancel out. Takes an optional out to avoid allocations."}, {"id": "docs_gameplay_camera_centering_baked_in_matrix", "label": "Centering baked into the view matrix", "file_type": "rationale", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "nebula stays top-left ('just a matrix') while the Unity-like centered convention lives entirely in gameplay: once renderer.camera.position = center \u2212 viewport/2, screenToWorld stays the simple top-left formula and automatically honours centering \u2014 only the sync needs to know the viewport size."}, {"id": "docs_gameplay_camera_single_active_camera", "label": "Single active camera", "file_type": "rationale", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many camera entities may exist but only one drives rendering, keeping nebula's one-pass model untouched; the gameplay camera is just another producer writing into renderer.camera, like the editor in edit mode."}, {"id": "docs_gameplay_camera_follow_via_parenting", "label": "Follow via parenting", "file_type": "concept", "source_file": "docs/gameplay/camera.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the sync reads WorldTransform2D (world, not local position), making the camera a child of the player gives follow behaviour for free with no dedicated system."}], "edges": [{"source": "docs_gameplay_camera_screentoworld", "target": "docs_backlog_b2_editor_nebula_reconciliation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_camerasyncsystem", "target": "docs_core_scheduling_stage_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_cameramanager", "target": "docs_gameplay_camera_camera_component", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_camerasyncsystem", "target": "docs_gameplay_camera_cameramanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_camerasyncsystem", "target": "docs_gameplay_camera_camera_component", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_camerasyncsystem", "target": "docs_gameplay_camera_centering_baked_in_matrix", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_cameraapi", "target": "docs_gameplay_camera_cameramanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_cameramanager", "target": "docs_gameplay_camera_screentoworld", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_centering_baked_in_matrix", "target": "docs_gameplay_camera_screentoworld", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_single_active_camera", "target": "docs_gameplay_camera_cameramanager", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_camerasyncsystem", "target": "docs_gameplay_camera_follow_via_parenting", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_follow_via_parenting", "target": "docs_gameplay_entity_hierarchy_worldtransform2d", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_camerasyncsystem", "target": "docs_gameplay_entity_hierarchy_transformpropagationsystem", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_cameraapi", "target": "docs_gameplay_input_scripting_scriptservice", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camera_cameraapi", "target": "docs_gameplay_input_scripting_inputapi", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/gameplay/camera.md", "source_location": null, "weight": 1.0}, {"source": "docs_gameplay_camer