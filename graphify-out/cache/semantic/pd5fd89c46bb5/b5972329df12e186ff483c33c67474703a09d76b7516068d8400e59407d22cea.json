{"nodes": [{"id": "docs_dino_brawl_cleanup_plan_cleanup_plan", "label": "Dino Brawl cleanup implementation plan", "file_type": "document", "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task-by-task checkbox plan (rename app \u2192 config/controls \u2192 React shell \u2192 tiled/ \u2192 dead code \u2192 spawn extraction) with build, lint, browser verify and a commit gate per task."}, {"id": "docs_dino_brawl_cleanup_plan_browser_verification_protocol", "label": "Browser verification protocol", "file_type": "concept", "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The WebGPU pane serves stale scenes under HMR, so the dev server must be restarted rather than hot-reloaded; every visual task compares against a reference screenshot taken before task 1."}, {"id": "docs_dino_brawl_cleanup_plan_tileset_characterization_test", "label": "TileSet characterization test", "file_type": "concept", "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written to fail first, it pins getId arithmetic as numerically identical for every valid gid while fixing the off-by-one in isIdIn bounds; a differing tile in the browser is a stop-and-report gate, never something to mask."}, {"id": "docs_dino_brawl_cleanup_plan_tileset_firstgid_normalization", "label": "firstGid normalization", "file_type": "concept", "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old code stored firstGid-1 then subtracted 1 again in getId; the two offsets cancelled, so normalizing to the real Tiled 1-based firstgid is byte-identical while eliminating the double -1. The y = columns-1-floor(...) line was deliberately preserved, not 'fixed'."}, {"id": "docs_dino_brawl_cleanup_plan_import_type_vite_constraint", "label": "import type constraint under Vite", "file_type": "rationale", "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With verbatimModuleSyntax, a value import of a type-only symbol compiles under tsc but breaks Vite at runtime (black screen) \u2014 which is why browser verification is mandatory, not just a green build."}], "edges": [{"source": "docs_dino_brawl_cleanup_plan_cleanup_plan", "target": "apps_dino_brawl_index_dino_brawl_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_dino_brawl_cleanup_plan_cleanup_plan", "target": "docs_dino_brawl_cleanup_cleanup_chantier", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_dino_brawl_cleanup_plan_cleanup_plan", "target": "docs_dino_brawl_cleanup_plan_browser_verification_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_dino_brawl_cleanup_plan_cleanup_plan", "target": "docs_dino_brawl_cleanup_plan_tileset_characterization_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/dino-brawl-cleanup-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_dino_brawl_cleanup_plan_tileset_characterization_test", "target": "docs_dino_brawl_cleanup_plan_tileset_firstgid_normalization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"